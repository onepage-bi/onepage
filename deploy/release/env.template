# OnePage: site settings.   cp env.template .env   and fill in the values below.
#
# A TRAP: a comment to the RIGHT of an EMPTY value becomes the value
# (`OP_INITIAL_ADMIN=   # who` creates an admin named "# who"). That is why every
# note in this file sits on the line ABOVE its variable. Keep it that way.

# ── 1. Address ────────────────────────────────────────────────────────────────
# The exact URL people type in the browser: scheme + host (+ port), no trailing
# slash. (The name says SAML for historical reasons; it is simply the address
# OnePage uses for itself, also with password sign-in.)
# No domain yet? Use http://<server-ip>:8000 with the port from below.
OP_SAML_SP_BASE_URL=http://onepage.example.com:8000

# Port published on the server (the container's own port is fixed).
OP_PUBLIC_PORT=8000

# Interface to listen on. Leave 0.0.0.0 to be reachable from the network; set
# 127.0.0.1 when a reverse proxy on this same machine does the https (see INSTALL.md).
# OP_BIND=127.0.0.1

# true ONLY when the address above starts with https:// (a reverse proxy in
# front, see INSTALL.md "Behind HTTPS"). false for plain http. A mismatch is
# refused at startup, on purpose: reports would show "Session expired".
OP_SAML_HTTPS=false

# ── 2. First administrator and password ───────────────────────────────────────
# The user name of the first administrator (created on first start).
OP_INITIAL_ADMIN=admin

# Comma-separated list of  user=hash  pairs. Make the hash with
#   docker run --rm -it onepage:latest python -m app.auth.local hash
# and paste it. Quote the WHOLE value with single quotes: the hash contains
# `$` characters, and inside single quotes they are taken literally.
# Example shape:  OP_LOCAL_USERS='admin=pbkdf2_sha256$600000$<salt>$<digest>'
OP_LOCAL_USERS=

# ── Optional ──────────────────────────────────────────────────────────────────
# Only if people reach the site under a second name (scheme+host[:port]).
# OP_TRUSTED_ORIGINS=http://192.0.2.5:8000

# Table catalogue pages, /explore (preview; needs extra assets, see INSTALL.md).
# OP_EXPLORE_ENABLED=true

# Quests (gamification).
# OP_QUESTS_ENABLED=true

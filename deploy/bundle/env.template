# OnePage: site settings.
#
#   cp env.template .env    and fill in the FIVE values below.
#
# Everything else (cache, telemetry, compression) is already hard-coded in docker-compose.yml;
# those values were obtained by measurement on the stand, and there is no need to touch them
# without a new measurement.
#
# If you forget any of the mandatory values, the application will NOT start: at startup
# preflight runs and prints the list of problems and what to do about each.
# This is deliberate: such an instance used to start successfully and answer
# /health: ok while being a system nobody could sign in to.


# ─────────────────────────────────────────────────────────────────────────────
# IF TRAEFIK SITS IN FRONT OF THE APPLICATION, run the variant
#   docker compose -f docker-compose.traefik.yml up -d
# and also fill in this block. With a plain nginx it is not needed.
#
# OP_HOSTNAME=onepage.example.com        # name for the Traefik router rule
#                                    # (OP_SAML_SP_BASE_URL is assembled automatically)
# TRAEFIK_NETWORK=traefik            # docker network ls
# TRAEFIK_ENTRYPOINT=websecure       # name of your https entrypoint
# TRAEFIK_CERTRESOLVER=default       # name of your certresolver
#
# MANDATORY: the subnet of Traefik's Docker network. Without it the perf and audit logs
# get Traefik's address instead of the client's: only 127.0.0.1 is trusted by default,
# and Traefik comes from 172.x.x.x. Never "*".
#   docker network inspect traefik --format '{{(index .IPAM.Config 0).Subnet}}'
# FORWARDED_ALLOW_IPS=172.18.0.0/16
# ─────────────────────────────────────────────────────────────────────────────


# ── 1. The address OnePage will be reachable at ───────────────────────────────
# Exactly the URL the user will see in the browser, with the scheme and without
# a trailing slash. The entityId and the ACS address for ADFS are derived from it.
OP_SAML_SP_BASE_URL=https://onepage.example.com


# ── 2. Who becomes the first administrator ────────────────────────────────────
# person_id (usually the employee number). The user is created on first startup.
# If you leave it empty and also turn dev sign-in off, nobody can sign in, and
# preflight refuses to start.
OP_INITIAL_ADMIN=


# ── 3-5. ADFS details ─────────────────────────────────────────────────────────
# These three values come from the ADFS administrator. Until you have them, you can start
# the instance with OP_SAML_STRICT=false (see below) and make sure everything else
# works, but SSO sign-in will not be possible.

OP_SAML_IDP_ENTITY_ID=http://adfs.example.com/adfs/services/trust
OP_SAML_IDP_SSO_URL=https://adfs.example.com/adfs/ls/

# Body of the IdP signing certificate, on ONE line, without BEGIN/END and without line breaks.
# Take it from the ADFS federation metadata:
#   curl -s https://adfs.example.com/FederationMetadata/2007-06/FederationMetadata.xml \
#     | grep -o '<X509Certificate>[^<]*' | head -1 | cut -c18-
OP_SAML_IDP_CERT=

# Name of the claim person_id is taken from. The default is UPN;
# confirm with the ADFS administrator. If you get it wrong, sign-in fails with an error
# that lists all the attributes received, which is what you fix it by.
OP_SAML_CLAIM_PERSON_ID=http://schemas.xmlsoap.org/ws/2005/05/identity/claims/upn


# ── Temporarily, only while setting up ────────────────────────────────────────
# Until the ADFS certificate is obtained, set false to start the instance and
# check the network, the proxy and rendering. You MUST set it back to true before
# letting people in: with false the assertion signature is not checked strictly.
# OP_SAML_STRICT=false

# Leave true if OnePage is served over https (the usual case).
# false with an https address: the cookie goes without Secure, and the dashboard iframe
# will show "Session expired". Preflight will not let that combination through.
# OP_SAML_HTTPS=true

# ── Table catalogue and Explore ────────────────────────────────────────────
# The /catalog and /explore pages are on by default; they can be turned off without
# migrations (false → 404). NL→SQL works only when OP_LLM_ENDPOINT is set.
# OP_CATALOG_ENABLED=true
# OP_EXPLORE_ENABLED=true
# OP_LLM_ENDPOINT=http://127.0.0.1:11434     # Ollama on this same host
# OP_LLM_MODEL=qwen2.5-coder:7b               # whichever `ollama list` shows
# OP_LLM_EXAMPLE_VALUES=0                     # 0 = only the schema goes to the LLM

# ── Model provider (docs/LLM_PROVIDERS.md) ────────────────────────────────
# ollama (default): a model inside our network, nothing leaves it.
# deepseek: an external provider (OpenAI-compatible /chat/completions).
# What leaves on this path: the question itself + metric names/definitions/cuts
# + glossary terms. Cell values NEVER.
# OP_LLM_PROVIDER=deepseek
# OP_LLM_ENDPOINT=https://api.deepseek.com    # may be left unset for deepseek
# OP_LLM_MODEL=deepseek-chat                  # may be left unset for deepseek
# OP_LLM_API_KEY=sk-...                       # key FOR THE SERVER (needs egress)
#
# Production setup: the server has NO egress (verified: ConnectTimeout to
# api.deepseek.com from the container), while users' browsers do, through the
# corporate proxy. Then THE PAGE ITSELF calls the model: the server builds the
# prompt (/api/explore/intent/prepare) and checks the answer
# (/api/explore/intent/validate), and the key leaves only from the browser.
# OP_LLM_BROWSER=true
# OP_LLM_BROWSER_KEY=sk-...   # the key is handed to signed-in users who
#                             # may run a generator (each handout is audited).
#                             # Empty = BYOK: everyone enters their own key, which lives
#                             # only in their browser's localStorage.
#
# DeepSeek is available only to users on the list (Administration,
# model card → "DeepSeek access"). ONLY the people listed here may grant access
# (comma-separated person_ids); empty = any administrator.
# OP_LLM_ACCESS_ADMINS=your_person_id

# ── Server-side lake cache (Phase 9.1) ────────────────────────────────────
# Parquet partitions of a report's source data, stored on the server in
# data/uploads/_lake/{dashboard_id}/, written by the report's generator.
# OP_LAKE_PART_MAX_MB=64      # ceiling per partition
# OP_LAKE_MAX_MB=1024         # ceiling for one report's whole lake directory
# OP_LAKE_EXEC=true           # ADR-14b: run /explore queries on the server over the lake
# OP_LAKE_EXEC_INSTANCES=2    # resident engine instances (frames in RAM), LRU

# ── Stand OUTSIDE the perimeter: password sign-in instead of ADFS (off by default) ──
# For a demo host without an IdP. A comma-separated list of "person_id=hash"; the hash is made by
#   docker compose exec onepage python -m app.auth.local hash
# The password never gets into .env. Only accounts that already exist in
# users can sign in (the admin creates them in /admin). The SSO button is hidden when
# OP_SAML_IDP_SSO_URL is empty. In corporate production LEAVE IT EMPTY.
# IMPORTANT: compose substitutes ${…} in .env, so every `$` of the hash in .env is written as `$$`:
# OP_LOCAL_USERS=admin1=pbkdf2_sha256$$600000$$...,tmr1=pbkdf2_sha256$$600000$$...
# For such a stand also: OP_SAML_STRICT=false, OP_SAML_HTTPS=false (if http)
# and OP_TRUSTED_ORIGINS=http://<host>:<port> if it differs from SP_BASE_URL.

# Copy to .env:  cp .env.example .env
#
# A TRAP this file has already fallen into: a comment to the RIGHT of an EMPTY
# value becomes the value. `OP_INITIAL_ADMIN=   # who is the first admin`
# creates an administrator named "# who is the first admin", and signing in to
# the stand is impossible. Put the note for an empty variable on the line ABOVE, not to the right.
#
OP_HOST=127.0.0.1
OP_PORT=8000
OP_WORKERS=1                         # uvicorn workers; >1 is safe (sessions in SQLite)

OP_DB_PATH=data/onepage.db
OP_UPLOADS_DIR=data/uploads

# person_id of the first administrator
OP_INITIAL_ADMIN=
OP_DEV_BYPASS_AUTH=true              # set to false in production

# ── How people sign in ────────────────────────────────────────────────────
# Three doors, any combination works. If none is configured and dev-bypass is
# off, preflight refuses to start so that you don't end up with a server nobody
# can sign in to.
#
# 1. Password. Works out of the box, nothing to install. The hash is computed with
#       python -m app.auth.local hash
#    and pasted here; the plain-text password is never stored anywhere.
#    OP_LOCAL_USERS=admin=pbkdf2_sha256$600000$<salt>$<hash>,analyst=pbkdf2_sha256$...
#    In docker-compose the dollar sign is doubled ($$), otherwise Compose eats it
#    as a variable substitution.
OP_LOCAL_USERS=

# 2. OIDC (Keycloak, Authentik, Okta, Google, Microsoft Entra). Fill in the
#    issuer and client; the platform discovers the rest by itself from
#    {issuer}/.well-known/openid-configuration.
OP_OIDC_ISSUER=
OP_OIDC_CLIENT_ID=
OP_OIDC_CLIENT_SECRET=
OP_OIDC_SCOPES=openid profile email
OP_OIDC_CLAIM_PERSON_ID=preferred_username   # which claim is the account name

# 3. SAML (ADFS). Needs a SEPARATE install: pip install -r requirements-saml.txt
#    (the package needs the system libxmlsec1-dev libxml2-dev pkg-config). If
#    the SAML settings are filled in but the package is missing, preflight says so at startup.

OP_SAML_SP_BASE_URL=http://localhost:8000   # real URL in production
OP_SAML_HTTPS=false                  # MUST be true when served over https:
                                     # drives Secure + SameSite=None on the
                                     # session cookie. Left false behind an
                                     # https URL, the sandboxed render iframe
                                     # never gets the cookie and every
                                     # dashboard shows "Session expired".
                                     # Startup preflight refuses that combo.
OP_SAML_IDP_ENTITY_ID=http://adfs.example.com/adfs/services/trust
OP_SAML_IDP_SSO_URL=https://adfs.example.com/adfs/ls/
# PEM body (no BEGIN/END headers)
OP_SAML_IDP_CERT=
OP_SAML_CLAIM_PERSON_ID=http://schemas.xmlsoap.org/ws/2005/05/identity/claims/upn
OP_SAML_STRICT=false                 # set to true in production
OP_SAML_WANT_ASSERTIONS_SIGNED=true  # the flag that actually authenticates a
                                     # login. Off = the SP accepts an UNSIGNED
                                     # assertion and anyone who can POST to
                                     # /saml/acs is any user. STRICT does not
                                     # cover this. Leave true.

OP_EXPLORE_ENABLED=false             # /explore and the report chat pane: a preview, off by default
OP_QUESTS_ENABLED=false              # /quests (gamification): optional, off by default; admins can also toggle it at /admin/quests

OP_PERF_ENABLED=true                 # collect request/DB/render timings
OP_PERF_SAMPLE=1.0                   # sampling CEILING (adaptive floats below it)
OP_PERF_ADAPTIVE=true                # steer sampling to OP_PERF_TARGET_RPS (off = fixed OP_PERF_SAMPLE)
OP_PERF_TARGET_RPS=200               # records/s budget for the adaptive sampler
OP_PERF_SAMPLE_FLOOR=0.01            # sampling never drops below this
OP_PERF_SQL=false                    # record individual SQL statements (verbose)
OP_PERF_CLIENT=true                  # collect browser-side timings
OP_PERF_DIR=data/perflog             # JSONL output directory
OP_PERF_RETENTION_DAYS=14            # delete perf files older than this
OP_PREVIEW_MAX_BYTES=1500000         # grid previews heavier than this show a placeholder
OP_SNAPSHOT_EXTERNAL=false           # snapshot data as immutable versioned snapshot.js (owner opt-in)
OP_CACHE_ENCODED=true                # keep compressed variants in the server render LRU (~1-3ms hits)
OP_CACHE_WARM=20                     # pre-render N most recent (+5 heaviest) dashboards at startup (0 = off)
OP_CACHE_MAX_MB=256                  # render LRU byte budget; 512+ on RAM-rich hosts keeps giants warm
OP_TEMPLATES_AUTO_RELOAD=true        # set to false in production
OP_ACCESS_LOG=false                  # uvicorn per-request log; measured at 91-96 µs
                                     # p50 on the hot path (C6). The reverse proxy
                                     # already keeps one. true only without a proxy.
